    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.19",
    "jsdom": "^24.1.3",
    "postcss": "^8.4.38",
    "rollup": "npm:@rollup/wasm-node@^4.68.2",
