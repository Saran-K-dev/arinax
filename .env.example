VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_API_BASE_URL=https://api.example.com

# Server-only values. Never prefix these with VITE_ or expose them to the browser.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=replace_with_server_only_sb_secret_key
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_server_only_test_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret_from_razorpay_dashboard
PORT=43128
ALLOWED_ORIGINS=https://YOUR_NETLIFY_SITE.netlify.app,https://www.example.com

# WhatsApp Cloud API. Dry-run records simulated delivery and sends no messages.
WHATSAPP_MODE=dry-run
WHATSAPP_ACCESS_TOKEN=server_only_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=meta_phone_number_id
WHATSAPP_GRAPH_API_VERSION=vXX.X
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_BOOKING_CONFIRMED=arena_booking_confirmed
WHATSAPP_TEMPLATE_BOOKING_CANCELLED=arena_booking_cancelled
WHATSAPP_TEMPLATE_BOOKING_REMINDER=arena_booking_reminder
WHATSAPP_APP_SECRET=meta_app_secret_for_webhook_signature
WHATSAPP_WEBHOOK_VERIFY_TOKEN=choose_a_random_webhook_verification_token
